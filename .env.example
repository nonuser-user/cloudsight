# CloudSight — copy this to ".env" and fill in your values.

# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=true

# MySQL (PyMySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cloudsight

# Storage plan size shown in the UI
PLAN_TOTAL_GB=500
